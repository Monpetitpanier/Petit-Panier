{
  "expo": {
    "name": "Petit Panier",
    "slug": "petit-panier",
    "icon": "./assets/illustrations/appli_panier.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monpetitpanier.app"
    },
    "android": {
      "package": "com.monpetitpanier.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/illustrations/appli_panier.png",
        "backgroundColor": "#FBF6EF"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "position": "absolute",
          "behavior": "overlay-swipe",
          "enforceContrast": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permet à Fifi de te prévenir quand tu passes près d'un lieu enregistré, même app fermée.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Petit Panier a besoin du micro pour écouter tes messages.",
          "speechRecognitionPermission": "Petit Panier utilise la reconnaissance vocale pour transformer ta voix en texte."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2e8ab694-a6e4-48d2-a35c-9cc322ea6a87"
      }
    }
  }
}